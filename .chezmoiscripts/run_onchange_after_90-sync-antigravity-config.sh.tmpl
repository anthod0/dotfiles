#!/bin/sh
set -eu

# Re-run when the Antigravity CLI sync script changes: {{ include "scripts/sync-antigravity-config.ts" | sha256sum }}

command -v bun >/dev/null 2>&1 || { echo "bun is required to sync Antigravity CLI config." >&2; exit 1; }
exec bun {{ joinPath .chezmoi.sourceDir "scripts/sync-antigravity-config.ts" | shellQuote }}
