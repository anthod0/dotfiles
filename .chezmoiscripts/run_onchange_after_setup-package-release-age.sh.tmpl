#!/bin/bash

# Track availability only: installing/removing tools reruns this script, upgrades do not.
# npm-installed: {{ if lookPath "npm" }}yes{{ else }}no{{ end }}
# pnpm-installed: {{ if lookPath "pnpm" }}yes{{ else }}no{{ end }}
# bun-installed: {{ if lookPath "bun" }}yes{{ else }}no{{ end }}

set -euo pipefail

# Changing this value reruns the script on the next chezmoi apply.
release_age_days=7

# Maintain the allowlist in .chezmoidata/package-release-age.yaml.
release_age_excludes='{{ .packageReleaseAge.excludes | toJson }}'

if command -v npm >/dev/null 2>&1; then
    npm config set min-release-age "$release_age_days" --location=user
    # Requires npm >=11.17.0. Write array entries directly: config set accepts scalars.
    node - "$(npm config get userconfig)" "$release_age_excludes" <<'JS'
const { readFile, writeFile } = require("node:fs/promises");

(async () => {
    const [path, excludesJSON] = process.argv.slice(2);
    const excludes = JSON.parse(excludesJSON);
    // npm config set above creates the user config file if needed.
    const source = await readFile(path, "utf8");
    const lines = source.split(/\r?\n/).filter(line =>
        !/^\s*min-release-age-exclude(?:\[\])?\s*=/.test(line));
    while (lines.at(-1) === "") lines.pop();
    for (const name of excludes) {
        lines.push(`min-release-age-exclude[]=${JSON.stringify(name)}`);
    }
    const updated = lines.join("\n") + "\n";
    if (updated !== source) await writeFile(path, updated, { mode: 0o600 });
})().catch(error => {
    console.error(error);
    process.exitCode = 1;
});
JS
else
    echo "npm not found. Skipping."
fi

if command -v pnpm >/dev/null 2>&1; then
    pnpm config set minimumReleaseAge "$((release_age_days * 24 * 60))" --global
    pnpm config set minimumReleaseAgeExclude "$release_age_excludes" --json --global
else
    echo "pnpm not found. Skipping."
fi

if command -v bun >/dev/null 2>&1; then
    # Bun's global config is under XDG_CONFIG_HOME when set, otherwise HOME.
    # Parsing preserves other settings, but serialization removes TOML comments.
    bun - "${XDG_CONFIG_HOME:-$HOME}/.bunfig.toml" "$((release_age_days * 24 * 60 * 60))" "$release_age_excludes" <<'JS'
import { mkdir, readFile, writeFile } from "node:fs/promises";
import { dirname } from "node:path";

const [path, seconds, excludesJSON] = process.argv.slice(2);
const excludes = JSON.parse(excludesJSON);
let source;
try {
    source = await readFile(path, "utf8");
} catch (error) {
    if (error.code !== "ENOENT") throw error;
    source = "";
}
const config = Bun.TOML.parse(source);
config.install ??= {};
if (typeof config.install !== "object" || Array.isArray(config.install)) {
    throw new Error(`Expected an [install] table in ${path}`);
}
const age = Number(seconds);
if (config.install.minimumReleaseAge !== age ||
    JSON.stringify(config.install.minimumReleaseAgeExcludes) !== JSON.stringify(excludes)) {
    config.install.minimumReleaseAge = age;
    config.install.minimumReleaseAgeExcludes = excludes;
    const updated = Bun.TOML.stringify(config);
    await mkdir(dirname(path), { recursive: true });
    await writeFile(path, updated, { mode: 0o600 });
}
JS
else
    echo "bun not found. Skipping."
fi
