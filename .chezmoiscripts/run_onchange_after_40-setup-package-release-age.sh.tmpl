#!/bin/sh
set -eu

# Track availability only: installing/removing tools reruns this script, upgrades do not.
# npm-installed: {{ if lookPath "npm" }}yes{{ else }}no{{ end }}
# pnpm-installed: {{ if lookPath "pnpm" }}yes{{ else }}no{{ end }}
# bun-installed: {{ if lookPath "bun" }}yes{{ else }}no{{ end }}
# script: {{ include "scripts/setup-package-release-age.ts" | sha256sum }}

command -v bun >/dev/null 2>&1 || { echo "bun is required to configure package release ages." >&2; exit 1; }
exec bun {{ joinPath .chezmoi.sourceDir "scripts/setup-package-release-age.ts" | shellQuote }} \
    72 {{ .packageReleaseAge.excludes | toJson | shellQuote }}
