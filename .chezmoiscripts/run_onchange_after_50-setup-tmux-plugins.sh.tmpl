#!/bin/bash

set -euo pipefail

# Re-run when the tmux configuration changes: {{ include "dot_tmux.conf" | sha256sum }}
TPM_DIR="$HOME/.tmux/plugins/tpm"

if ! command -v git >/dev/null 2>&1; then
    echo "git is required to install TPM." >&2
    exit 1
fi

if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux is required to install TPM plugins." >&2
    exit 1
fi

if [ -d "$TPM_DIR/.git" ]; then
    echo "TPM is already installed."
elif [ -e "$TPM_DIR" ]; then
    echo "$TPM_DIR already exists but is not a Git repository; refusing to overwrite it." >&2
    exit 1
else
    echo "=== clone TPM ==="
    git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
fi

echo "=== install tmux plugins ==="
"$TPM_DIR/bin/install_plugins"
