{{- $repo := "anthod0/skills" -}}
{{- $repoURL := printf "https://github.com/%s" $repo -}}
{{- $releasePath := (urlParse (getRedirectedURL (printf "%s/releases/latest" $repoURL))).path -}}
{{- $ref := "HEAD" -}}
{{- $tagPrefix := printf "/%s/releases/tag/" $repo -}}
{{- if hasPrefix $tagPrefix $releasePath -}}
{{- $ref = printf "refs/tags/%s" (trimPrefix $tagPrefix $releasePath) -}}
{{- end -}}
#!/bin/bash

# Track the latest release tag (including annotated tags), or the default branch.
# upstream: {{ output "git" "ls-remote" "--exit-code" $repoURL $ref (printf "%s^{}" $ref) | trim | replace "\n" "; " }}

set -euo pipefail

for tool in gh jq; do
    command -v "$tool" >/dev/null || {
        echo "$tool is required to manage skills." >&2
        exit 1
    }
done

repo={{ $repo | quote }}
skills_dir=$HOME/.agents/skills
lock_file=$HOME/.agents/.skill-lock.json

skill_names=''
if [[ -f $lock_file ]]; then
    skill_names=$(jq -r --arg repo "$repo" '
        .skills // {} | to_entries[] | select(.value.source == $repo) | .key
    ' "$lock_file")
fi

# Never prompt to overwrite existing skills during chezmoi apply.
export GH_PROMPT_DISABLED=1

if [[ -n $skill_names ]]; then
    mapfile -t skills <<< "$skill_names"
    gh skill update --all --dir "$skills_dir" "${skills[@]}"
else
    gh skill install "$repo" --all --agent universal --scope user
fi
