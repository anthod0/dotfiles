#!/bin/sh

# Use the local desktop clipboard when possible. Over SSH, send OSC 52 to the
# connecting terminal instead. Inside tmux, OSC 52 also targets the active tmux
# client, whereas display environment variables may belong to an older session.
if [ "$#" -ne 0 ]; then
    printf 'Usage: lg-copy\n' >&2
    exit 2
fi

if [ -n "${TMUX:-}" ]; then
    {
        printf '\033Ptmux;\033\033]52;c;'
        base64 | tr -d '\n'
        printf '\a\033\\'
    } > /dev/tty
elif [ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" ]; then
    {
        printf '\033]52;c;'
        base64 | tr -d '\n'
        printf '\a'
    } > /dev/tty
elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy --type text/plain
elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard
elif [ -n "${DISPLAY:-}" ] && command -v xsel >/dev/null 2>&1; then
    exec xsel --clipboard --input
else
    {
        printf '\033]52;c;'
        base64 | tr -d '\n'
        printf '\a'
    } > /dev/tty
fi
